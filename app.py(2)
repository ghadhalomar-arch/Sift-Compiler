"""Sift Compiler | Phase 1 — a minimal, pink-accented Streamlit GUI.

All tokenization is performed by the existing scan() function in scanner.py.
"""

from __future__ import annotations

import re

import pandas as pd
import streamlit as st

from scanner import scan


st.set_page_config(page_title="Sift | Lexical Analyzer", layout="wide")

PINK = "#F472B6"
EXAMPLES = {
    "Count students": '''analysis StudentCount
  load students from "students.csv" with (name text, score number, hours number)
  let total = count(students)
  show total
end''',
    "Filter and sort": '''analysis PassingStudents
  load students from "students.csv" with (name text, score number, hours number)
  keep students where score >= 60
  sort students by score desc
  show students
end''',
    "Student average": '''analysis StudentAverage
  load grades from "grades.csv" with (name text, score number)
  let student = "Amal"
  keep grades where name == student
  let total = sum(grades.score)
  let countGrades = count(grades)
  let average = total / countGrades
  show average
end''',
    "Lexical errors": '''analysis Errors
  let result = 12abc
  let aVeryLongIdentifierName = 5
  show "missing quote
  show @
end''',
}


def load_example() -> None:
    st.session_state.code = EXAMPLES[st.session_state.selected_example]
    st.session_state.result = None


def clear_editor() -> None:
    st.session_state.code = ""
    st.session_state.result = None


if "code" not in st.session_state:
    st.session_state.code = EXAMPLES["Count students"]
if "result" not in st.session_state:
    st.session_state.result = None

# CSS only: the visible header uses native Streamlit text, which prevents
# the raw HTML issue that appeared in earlier versions of the app.
st.markdown("""<style>
  .block-container { max-width: 1120px; padding-top: 3.5rem; padding-bottom: 3.2rem; }
  h1 { letter-spacing: -.035em; font-weight: 750; }
  h2, h3 { letter-spacing: -.02em; }
  div[data-testid="stTextArea"] textarea {
      font-family: "Cascadia Code", "JetBrains Mono", Consolas, monospace;
      font-size: .94rem; line-height: 1.65;
      border-radius: 12px;
  }
  div[data-testid="stMetric"] {
      background: #152337;
      border: 1px solid #493146;
      border-radius: 12px;
      padding: 13px 16px;
  }
  div[data-testid="stMetricLabel"] { color: #D5B8C9; }
  /* The theme sets primary buttons pink; these rules enforce the same color. */
  button[kind="primary"],
  button[data-testid="stBaseButton-primary"],
  button[data-testid="baseButton-primary"] {
      background-color: #F472B6 !important;
      border-color: #F472B6 !important;
      color: #15111D !important;
      font-weight: 700 !important;
  }
  button[kind="primary"]:hover,
  button[data-testid="stBaseButton-primary"]:hover,
  button[data-testid="baseButton-primary"]:hover {
      background-color: #EC4899 !important;
      border-color: #EC4899 !important;
      color: #15111D !important;
  }
  button[kind="secondary"]:hover { border-color: #F472B6 !important; }
</style>""", unsafe_allow_html=True)

st.caption("SIFT  /  COMPILER COURSE PROJECT")
st.title("Lexical Analyzer")
st.caption("Phase 1  ·  Write Sift code and inspect tokens, identifiers, and lexical errors.")
st.divider()

# Source editor: a single, uncluttered workspace.
st.subheader("Code editor")
example_col, apply_col, clear_col = st.columns([4, 1.4, 1.4], gap="small", vertical_alignment="bottom")
with example_col:
    st.selectbox("Sample program", options=list(EXAMPLES), key="selected_example")
with apply_col:
    st.button("Load sample", on_click=load_example, use_container_width=True)
with clear_col:
    st.button("Clear", on_click=clear_editor, use_container_width=True)

st.text_area(
    "Sift source code",
    key="code",
    height=290,
    label_visibility="collapsed",
    placeholder="analysis Demo\n  let value = 10\n  show value\nend",
)

run_col, save_col = st.columns([4, 1.5], gap="small")
with run_col:
    run_clicked = st.button(
        "Run scanner",
        type="primary",
        use_container_width=True,
        disabled=not bool(st.session_state.code.strip()),
    )
with save_col:
    st.download_button(
        "Save code (.sift)",
        data=st.session_state.code,
        file_name="program.sift",
        mime="text/plain",
        use_container_width=True,
    )

if run_clicked:
    try:
        tokens, symbols, errors = scan(st.session_state.code)
        st.session_state.result = {
            "source": st.session_state.code,
            "tokens": tokens,
            "symbols": symbols,
            "errors": errors,
        }
    except Exception as exc:
        st.session_state.result = None
        st.error(f"Unable to run scanner: {exc}")

st.divider()
st.subheader("Scan results")
result = st.session_state.result

if result is None:
    st.info("Click **Run scanner** to see your analysis results.")
else:
    tokens = result["tokens"]
    symbols = result["symbols"]
    errors = result["errors"]
    scanned_source = result["source"]

    if st.session_state.code != scanned_source:
        st.warning("The code has changed since the last scan. Run the scanner again for updated results.")

    m1, m2, m3, m4 = st.columns(4, gap="small")
    m1.metric("Tokens", len(tokens))
    m2.metric("Identifiers", len(symbols))
    m3.metric("Lines", len(scanned_source.splitlines()))
    m4.metric("Errors", len(errors))

    if errors:
        st.warning(f"Scan finished with {len(errors)} lexical error(s).")
    else:
        st.success("Scan completed — no lexical errors found.")

    tokens_tab, symbols_tab, errors_tab = st.tabs(
        ["Tokens", "Symbol table", f"Lexical errors ({len(errors)})"]
    )

    with tokens_tab:
        if not tokens:
            st.info("No tokens recognized.")
        else:
            token_df = pd.DataFrame(tokens, columns=["Type", "Line", "Lexeme"])
            st.dataframe(token_df, use_container_width=True, hide_index=True, height=320)
            st.download_button(
                "Download tokens (CSV)",
                token_df.to_csv(index=False).encode("utf-8"),
                file_name="tokens.csv",
                mime="text/csv",
            )

    with symbols_tab:
        if not symbols:
            st.info("No identifiers found.")
        else:
            symbols_df = pd.DataFrame(
                [{"Identifier": identifier, "First line": line} for identifier, line in symbols.items()]
            )
            st.dataframe(symbols_df, use_container_width=True, hide_index=True, height=320)
            st.download_button(
                "Download symbol table (CSV)",
                symbols_df.to_csv(index=False).encode("utf-8"),
                file_name="symbol_table.csv",
                mime="text/csv",
            )

    with errors_tab:
        if not errors:
            st.success("No lexical errors found.")
        else:
            source_lines = scanned_source.splitlines()
            for error in errors:
                st.error(error)
                found = re.match(r"Line (\d+):", error)
                if found:
                    line_num = int(found.group(1))
                    if 1 <= line_num <= len(source_lines):
                        st.code(source_lines[line_num - 1], language=None)

st.caption("Sift Compiler  ·  Phase 1 — Lexical analysis only")
